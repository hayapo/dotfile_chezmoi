[tools]
node = "26"
pnpm = "12"
rust = { version = "stable", profile = "default", components = "clippy,rustfmt,rust-src,rust-docs", targets = "{{ includeTemplate ".chezmoitemplates/rust-target.tmpl" . }},x86_64-unknown-none" }

[settings]
lockfile = true

[settings.rust]
rustup_home = "{{ .chezmoi.homeDir }}/.local/share/mise/rustup"
cargo_home = "{{ .chezmoi.homeDir }}/.local/share/mise/cargo"
