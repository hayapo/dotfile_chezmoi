[tools]
node = "26"
pnpm = "12"
rust = { version = "stable", profile = "default", components = "clippy,rustfmt,rust-src,rust-docs", targets = "{{ if eq .chezmoi.os "darwin" }}aarch64-apple-darwin{{ else }}x86_64-unknown-linux-gnu{{ end }},x86_64-unknown-none" }

[settings]
lockfile = true

[settings.rust]
rustup_home = "{{ .chezmoi.homeDir }}/.local/share/mise/rustup"
cargo_home = "{{ .chezmoi.homeDir }}/.local/share/mise/cargo"
